<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dùng AppBarLayout để chứa Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Material3.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:contentDescription="@string/title_evshop"
            app:title="@string/title_evshop"
            app:titleTextColor="@color/white"
            app:menu="@menu/menu_home" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 2. Thêm "layout_behavior" để fragment tự động nằm dưới AppBarLayout -->
    <!-- Xóa bỏ layout_marginTop thủ công -->
    <fragment
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:navGraph="@navigation/nav_main" />

    <!-- Các nút này đã được đặt đúng cách với layout_gravity, chúng sẽ nổi lên trên fragment -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Chat với cửa hàng"
        android:src="@drawable/ic_send_24"
        android:visibility="gone"
        app:tint="@android:color/white" />

    <Button
        android:id="@+id/speechAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speech again"
        android:visibility="gone"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
