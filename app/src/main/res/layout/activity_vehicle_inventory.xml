<?xml version="1.0" encoding="utf-8"?>
<!-- Sử dụng một FrameLayout để có thể xếp chồng các View lên nhau -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.admin.VehicleInventoryActivity">

    <!-- RecyclerView để hiển thị danh sách xe. ID chính xác nằm ở đây -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_inventory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="?attr/actionBarSize"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_inventory_vehicle" />

    <!-- View thông báo lỗi/trống, nằm ở giữa màn hình -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:visibility="gone"
        tools:text="Không có xe nào trong kho"
        tools:visibility="visible"/>

    <!-- Vòng xoay loading, nằm ở giữa màn hình, trên cùng -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Toolbar nằm ở lớp trên cùng -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Quản Lý Kho Xe"
        app:titleTextColor="?attr/colorOnPrimary" />

</FrameLayout>
